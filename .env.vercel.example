# ==============================================
# ENV Vercel — copy nilai ini ke:
# Vercel Dashboard > Project > Settings > Environment Variables
# ==============================================

APP_NAME=TemuJasa
APP_ENV=production
APP_DEBUG=false
# Ganti dengan domain Vercel kamu, mis. https://temujasa.vercel.app
APP_URL=https://your-app.vercel.app
APP_KEY=base64:TGaVaXwhWgjn9akhE4SCSIjGG/cQqvICUQ+PgLA3Bs0=

# ---------- DATABASE EKSTERNAL (MySQL) ----------
# Bisa pakai: Aiven Free MySQL, PlanetScale, TiDB Cloud,
# Railway, Neon (postgres), atau hosting MySQL lain yang
# mengizinkan koneksi publik.
DB_CONNECTION=mysql
DB_HOST=your-db-host.provider.com
DB_PORT=3306
DB_DATABASE=temujasa
DB_USERNAME=db-user
DB_PASSWORD=db-password

# Wajib untuk provider yang mewajibkan SSL (Aiven, TiDB, dsb).
# Kosongkan jika provider tidak butuh SSL.
MYSQL_ATTR_SSL_CA=

# ---------- SESSION / CACHE (serverless-safe) ----------
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
