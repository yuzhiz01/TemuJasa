{
    "version": 2,
    "framework": null,
    "buildCommand": null,
    "outputDirectory": "dist",
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
        { "source": "/login", "destination": "/login/index.html" },
        { "source": "/register", "destination": "/register/index.html" },
        { "source": "/register/pelanggan", "destination": "/register/pelanggan/index.html" },
        { "source": "/register/penyedia", "destination": "/register/penyedia/index.html" },
        { "source": "/pelanggan/dashboard", "destination": "/pelanggan/dashboard/index.html" },
        { "source": "/penyedia/dashboard", "destination": "/penyedia/dashboard/index.html" },
        { "source": "/jasa/cari", "destination": "/jasa/cari/index.html" },
        { "source": "/cari", "destination": "/jasa/cari/index.html" },
        { "source": "/penyedia-profil/2", "destination": "/penyedia-profil/2/index.html" },
        { "source": "/penyedia-profil/4", "destination": "/penyedia-profil/4/index.html" },
        { "source": "/penyedia-profil/:id", "destination": "/penyedia-profil/2/index.html" }
    ]
}
