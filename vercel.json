{
    "version": 2,
    "outputDirectory": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "routes": [
        { "src": "/build/(.*)", "dest": "/build/$1" },
        { "src": "/css/(.*)", "dest": "/css/$1" },
        { "src": "/js/(.*)", "dest": "/js/$1" },
        { "src": "/api/(.*)", "dest": "/api/$1" },
        { "src": "/favicon.ico", "dest": "/favicon.ico" },
        { "src": "/robots.txt", "dest": "/robots.txt" },
        { "src": "/login", "dest": "/login/index.html" },
        { "src": "/register", "dest": "/register/index.html" },
        { "src": "/register/pelanggan", "dest": "/register/pelanggan/index.html" },
        { "src": "/register/penyedia", "dest": "/register/penyedia/index.html" },
        { "src": "/jasa/cari", "dest": "/jasa/cari/index.html" },
        { "src": "/penyedia-profil/2", "dest": "/penyedia-profil/2/index.html" },
        { "src": "/penyedia-profil/4", "dest": "/penyedia-profil/4/index.html" },
        { "src": "/", "dest": "/index.html" }
    ]
}
